# Copy this file to .env before the first `npm run db:migrate`.

# The SQLite file that holds settings and talks. Resolved relative to the project root.
DATABASE_URL="file:./dev.db"

# Path to the CLASH clone. The publish step starts the CLASH MCP server from
# <CLASH_DIR>/mcp/server.ts. Resolved relative to the working directory of the dev server.
CLASH_DIR=../clash

# No credentials belong in this file. The Claude Agent SDK takes them from the shell
# that starts `npm run dev` (an ANTHROPIC_API_KEY or an existing Claude login).
